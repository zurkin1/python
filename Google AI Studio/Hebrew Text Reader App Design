      "text": "### Architecture Selection\n\nFor this first version, I have selected the **Web Speech API (Browser-based TTS)**.\n\n**Why this architecture?**\n1.  **Privacy:** The text never leaves the user\u0027s device. Processing happens locally in the browser.\n2.  **Simplicity:** No server-side infrastructure, API keys, or databases are required, making it fast and lightweight.\n3.  **Cost:** It is entirely free to use.\n4.  **Device Integration:** It leverages the native Hebrew voices already installed on Android/Samsung (like Samsung TTS or Google Speech Services).\n\n**Limitations \u0026 Implementation:**\nThe Web Speech API does not provide a \"seek\" function or an \"estimated duration\" in seconds. To fulfill the requirements for **Rewind**, **Forward**, and **Progress Tracking**, I have implemented a logic that tracks the character index being spoken. \"Rewind 10s\" is approximated by jumping back a chunk of text, and the progress bar reflects the percentage of characters read.\n\n---\n\n### The Implementation\n\nYou can save the following code as a single `.html` file (e.g., `hebrew-reader.html`) and open it in any mobile or desktop browser.\n\n```html\n\u003c!DOCTYPE html\u003e\n\u003chtml lang\u003d\"he\" dir\u003d\"rtl\"\u003e\n\u003chead\u003e\n    \u003cmeta charset\u003d\"UTF-8\"\u003e\n    \u003cmeta name\u003d\"viewport\" content\u003d\"width\u003ddevice-width, initial-scale\u003d1.0\"\u003e\n    \u003ctitle\u003eHebrew Reader\u003c/title\u003e\n    \u003cscript src\u003d\"https://cdn.tailwindcss.com\"\u003e\u003c/script\u003e\n    \u003cstyle\u003e\n        @import url(\u0027https://fonts.googleapis.com/css2?family\u003dAssistant:wght@300;400;600;700\u0026display\u003dswap\u0027);\n        \n        body {\n            font-family: \u0027Assistant\u0027, sans-serif;\n            background-color: #f8fafc;\n            transition: background-color 0.3s ease;\n        }\n\n        @media (prefers-color-scheme: dark) {\n            body { background-color: #0f172a; color: #f1f5f9; }\n            .card { background-color: #1e293b; border-color: #334155; }\n            textarea { background-color: #334155; color: white; border-color: #475569; }\n        }\n\n        .card {\n            background: white;\n            border-radius: 1.5rem;\n            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);\n        }\n\n        .progress-bar-inner {\n            transition: width 0.2s linear;\n        }\n\n        /* Large touch targets for mobile */\n        button {\n            touch-action: manipulation;\n            min-height: 44px;\n        }\n    \u003c/style\u003e\n\u003c/head\u003e\n\u003cbody class\u003d\"p-4 md:p-8 min-h-screen flex items-center justify-center\"\u003e\n\n    \u003cdiv class\u003d\"max-w-2xl w-full\"\u003e\n        \u003c!-- Header --\u003e\n        \u003cheader class\u003d\"text-center mb-8\"\u003e\n            \u003ch1 class\u003d\"text-3xl font-bold text-blue-600 dark:text-blue-400 mb-2\"\u003eHebrew Reader\u003c/h1\u003e\n            \u003cp class\u003d\"text-slate-600 dark:text-slate-400\"\u003eהדבק טקסט בעברית והאזן לו בבירור.\u003c/p\u003e\n        \u003c/header\u003e\n\n        \u003cmain class\u003d\"card p-6 md:p-8 border border-slate-200\"\u003e\n            \u003c!-- Text Input Area --\u003e\n            \u003cdiv class\u003d\"relative mb-4\"\u003e\n                \u003ctextarea \n                    id\u003d\"textInput\"\n                    placeholder\u003d\"הדבק כאן טקסט בעברית...\"\n                    class\u003d\"w-full h-64 p-4 text-xl border-2 border-slate-200 rounded-xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 outline-none resize-none\"\n                    dir\u003d\"rtl\"\u003e\u003c/textarea\u003e\n                \n                \u003cdiv class\u003d\"flex justify-between mt-2 text-sm text-slate-500\"\u003e\n                    \u003cspan id\u003d\"charCount\"\u003e0 תווים\u003c/span\u003e\n                    \u003cdiv class\u003d\"flex gap-4\"\u003e\n                        \u003cbutton onclick\u003d\"clearText()\" class\u003d\"text-red-500 hover:font-bold\"\u003eנקה הכל\u003c/button\u003e\n                        \u003cbutton onclick\u003d\"pasteText()\" class\u003d\"text-blue-500 hover:font-bold\"\u003eהדבק טקסט\u003c/button\u003e\n                    \u003c/div\u003e\n                \u003c/div\u003e\n            \u003c/div\u003e\n\n            \u003c!-- Voice \u0026 Speed Settings --\u003e\n            \u003cdiv class\u003d\"grid grid-cols-1 md:grid-cols-2 gap-4 mb-6\"\u003e\n                \u003cdiv\u003e\n                    \u003clabel class\u003d\"block text-sm font-semibold mb-1\"\u003eבחר קול (Voice)\u003c/label\u003e\n                    \u003cselect id\u003d\"voiceSelect\" class\u003d\"w-full p-2 border rounded-lg bg-white dark:bg-slate-700\"\u003e\u003c/select\u003e\n                \u003c/div\u003e\n                \u003cdiv\u003e\n                    \u003clabel class\u003d\"block text-sm font-semibold mb-1\"\u003eמהירות הקראה\u003c/label\u003e\n                    \u003cselect id\u003d\"rateSelect\" class\u003d\"w-full p-2 border rounded-lg bg-white dark:bg-slate-700\"\u003e\n                        \u003coption value\u003d\"0.75\"\u003e0.75x\u003c/option\u003e\n                        \u003coption value\u003d\"1\" selected\u003e1x (רגיל)\u003c/option\u003e\n                        \u003coption value\u003d\"1.25\"\u003e1.25x\u003c/option\u003e\n                        \u003coption value\u003d\"1.5\"\u003e1.5x\u003c/option\u003e\n                        \u003coption value\u003d\"2\"\u003e2x\u003c/option\u003e\n                    \u003c/select\u003e\n                \u003c/div\u003e\n            \u003c/div\u003e\n\n            \u003c!-- Status Indicator --\u003e\n            \u003cdiv id\u003d\"status\" class\u003d\"text-center text-sm font-medium mb-4 text-slate-500 italic\"\u003eמוכן להקראה\u003c/div\u003e\n\n            \u003c!-- Progress Bar --\u003e\n            \u003cdiv class\u003d\"w-full bg-slate-200 dark:bg-slate-700 h-2 rounded-full mb-6 overflow-hidden\"\u003e\n                \u003cdiv id\u003d\"progressBar\" class\u003d\"progress-bar-inner bg-blue-500 h-full w-0\"\u003e\u003c/div\u003e\n            \u003c/div\u003e\n\n            \u003c!-- Playback Controls --\u003e\n            \u003cdiv id\u003d\"controls\" class\u003d\"grid grid-cols-3 md:grid-cols-6 gap-2\"\u003e\n                \u003cbutton onclick\u003d\"rewind()\" class\u003d\"flex flex-col items-center justify-center p-2 rounded-lg bg-slate-100 dark:bg-slate-700 hover:bg-slate-200\" title\u003d\"10 שניות אחורה\"\u003e\n                    \u003cspan class\u003d\"text-xs\"\u003e-10s\u003c/span\u003e\n                    \u003csvg class\u003d\"w-6 h-6\" fill\u003d\"currentColor\" viewBox\u003d\"0 0 24 24\"\u003e\u003cpath d\u003d\"M12.5 8c-2.65 0-5.05 1-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z\"/\u003e\u003c/svg\u003e\n                \u003c/button\u003e\n                \n                \u003cbutton id\u003d\"playBtn\" onclick\u003d\"playText()\" class\u003d\"col-span-1 bg-blue-600 text-white rounded-lg p-2 hover:bg-blue-700 flex items-center justify-center\"\u003e\n                    \u003csvg class\u003d\"w-8 h-8\" fill\u003d\"currentColor\" viewBox\u003d\"0 0 24 24\"\u003e\u003cpath d\u003d\"M8 5v14l11-7z\"/\u003e\u003c/svg\u003e\n                \u003c/button\u003e\n\n                \u003cbutton id\u003d\"pauseBtn\" onclick\u003d\"pauseText()\" class\u003d\"hidden bg-yellow-500 text-white rounded-lg p-2 hover:bg-yellow-600 flex items-center justify-center\"\u003e\n                    \u003csvg class\u003d\"w-8 h-8\" fill\u003d\"currentColor\" viewBox\u003d\"0 0 24 24\"\u003e\u003cpath d\u003d\"M6 19h4V5H6v14zm8-14v14h4V5h-4z\"/\u003e\u003c/svg\u003e\n                \u003c/button\u003e\n\n                \u003cbutton id\u003d\"resumeBtn\" onclick\u003d\"resumeText()\" class\u003d\"hidden bg-green-600 text-white rounded-lg p-2 hover:bg-green-700 flex items-center justify-center\"\u003e\n                    \u003csvg class\u003d\"w-8 h-8\" fill\u003d\"currentColor\" viewBox\u003d\"0 0 24 24\"\u003e\u003cpath d\u003d\"M8 5v14l11-7z\"/\u003e\u003c/svg\u003e\n                \u003c/button\u003e\n\n                \u003cbutton onclick\u003d\"stopText()\" class\u003d\"bg-slate-200 dark:bg-slate-600 rounded-lg p-2 hover:bg-slate-300 flex items-center justify-center\"\u003e\n                    \u003csvg class\u003d\"w-8 h-8\" fill\u003d\"currentColor\" viewBox\u003d\"0 0 24 24\"\u003e\u003cpath d\u003d\"M6 6h12v12H6z\"/\u003e\u003c/svg\u003e\n                \u003c/button\u003e\n\n                \u003cbutton onclick\u003d\"forward()\" class\u003d\"flex flex-col items-center justify-center p-2 rounded-lg bg-slate-100 dark:bg-slate-700 hover:bg-slate-200\" title\u003d\"30 שניות קדימה\"\u003e\n                    \u003cspan class\u003d\"text-xs\"\u003e+30s\u003c/span\u003e\n                    \u003csvg class\u003d\"w-6 h-6\" fill\u003d\"currentColor\" viewBox\u003d\"0 0 24 24\"\u003e\u003cpath d\u003d\"M18.41 10.6C16.55 9 14.15 8 11.5 8c-4.65 0-8.58 3.03-9.96 7.22L3.91 16c1.05-3.19 4.06-5.5 7.6-5.5 1.96 0 3.73.72 5.12 1.88L13 16h9V7l-3.59 3.6z\"/\u003e\u003c/svg\u003e\n                \u003c/button\u003e\n            \u003c/div\u003e\n\n            \u003c!-- Error Message Area --\u003e\n            \u003cdiv id\u003d\"errorBox\" class\u003d\"hidden mt-4 p-3 bg-red-100 text-red-700 rounded-lg text-sm\"\u003e\u003c/div\u003e\n        \u003c/main\u003e\n        \n        \u003cfooter class\u003d\"mt-8 text-center text-slate-500 text-xs\"\u003e\n            Built for privacy. No text is sent to a server.\n        \u003c/footer\u003e\n    \u003c/div\u003e\n\n    \u003cscript\u003e\n        const synth \u003d window.speechSynthesis;\n        const textInput \u003d document.getElementById(\u0027textInput\u0027);\n        const charCount \u003d document.getElementById(\u0027charCount\u0027);\n        const voiceSelect \u003d document.getElementById(\u0027voiceSelect\u0027);\n        const rateSelect \u003d document.getElementById(\u0027rateSelect\u0027);\n        const statusText \u003d document.getElementById(\u0027status\u0027);\n        const progressBar \u003d document.getElementById(\u0027progressBar\u0027);\n        const errorBox \u003d document.getElementById(\u0027errorBox\u0027);\n\n        const playBtn \u003d document.getElementById(\u0027playBtn\u0027);\n        const pauseBtn \u003d document.getElementById(\u0027pauseBtn\u0027);\n        const resumeBtn \u003d document.getElementById(\u0027resumeBtn\u0027);\n\n        let voices \u003d [];\n        let currentUtterance \u003d null;\n        let charIndex \u003d 0; // Track position for seek/progress\n\n        // Load voices\n        function loadVoices() {\n            voices \u003d synth.getVoices();\n            const hebrewVoices \u003d voices.filter(v \u003d\u003e v.lang.includes(\u0027he\u0027));\n            \n            voiceSelect.innerHTML \u003d \u0027\u0027;\n            \n            if (hebrewVoices.length \u003d\u003d\u003d 0) {\n                showError(\"לא נמצא קול בעברית במכשיר זה. אנא התקן \u0027Google Speech Services\u0027 בהגדרות המכשיר.\");\n                const opt \u003d document.createElement(\u0027option\u0027);\n                opt.textContent \u003d \"קול עברי לא זמין\";\n                voiceSelect.appendChild(opt);\n            } else {\n                errorBox.classList.add(\u0027hidden\u0027);\n                hebrewVoices.forEach(voice \u003d\u003e {\n                    const option \u003d document.createElement(\u0027option\u0027);\n                    option.value \u003d voice.name;\n                    option.textContent \u003d `${voice.name} (${voice.lang})`;\n                    voiceSelect.appendChild(option);\n                });\n            }\n        }\n\n        // Initialize voices (needs handling for Chrome vs others)\n        loadVoices();\n        if (speechSynthesis.onvoiceschanged !\u003d\u003d undefined) {\n            speechSynthesis.onvoiceschanged \u003d loadVoices;\n        }\n\n        // Textarea listeners\n        textInput.addEventListener(\u0027input\u0027, () \u003d\u003e {\n            const len \u003d textInput.value.length;\n            charCount.textContent \u003d `${len} תווים`;\n            updateControlsVisibility();\n        });\n\n        async function pasteText() {\n            try {\n                const text \u003d await navigator.clipboard.readText();\n                textInput.value \u003d text;\n                textInput.dispatchEvent(new Event(\u0027input\u0027));\n            } catch (err) {\n                showError(\"לא ניתן לגשת ללוח ההעתקה.\");\n            }\n        }\n\n        function clearText() {\n            stopText();\n            textInput.value \u003d \u0027\u0027;\n            textInput.dispatchEvent(new Event(\u0027input\u0027));\n        }\n\n        function showError(msg) {\n            errorBox.textContent \u003d msg;\n            errorBox.classList.remove(\u0027hidden\u0027);\n        }\n\n        function updateControlsVisibility() {\n            const hasText \u003d textInput.value.trim().length \u003e 0;\n            const btns \u003d document.querySelectorAll(\u0027#controls button\u0027);\n            btns.forEach(btn \u003d\u003e btn.disabled \u003d !hasText);\n        }\n\n        function playText(startIndex \u003d 0) {\n            if (!textInput.value.trim()) return;\n\n            synth.cancel();\n            charIndex \u003d startIndex;\n            \n            const utterance \u003d new SpeechSynthesisUtterance(textInput.value.substring(startIndex));\n            const selectedVoice \u003d voices.find(v \u003d\u003e v.name \u003d\u003d\u003d voiceSelect.value);\n            \n            if (selectedVoice) utterance.voice \u003d selectedVoice;\n            utterance.lang \u003d \u0027he-IL\u0027;\n            utterance.rate \u003d parseFloat(rateSelect.value);\n\n            utterance.onstart \u003d () \u003d\u003e {\n                statusText.textContent \u003d \"מקריא...\";\n                togglePlayButtons(\u0027playing\u0027);\n            };\n\n            utterance.onpause \u003d () \u003d\u003e {\n                statusText.textContent \u003d \"מושהה\";\n                togglePlayButtons(\u0027paused\u0027);\n            };\n\n            utterance.onend \u003d () \u003d\u003e {\n                if (charIndex \u003e\u003d textInput.value.length - 1) {\n                    statusText.textContent \u003d \"הסתיים\";\n                    progressBar.style.width \u003d \u0027100%\u0027;\n                    togglePlayButtons(\u0027stopped\u0027);\n                }\n            };\n\n            utterance.onboundary \u003d (event) \u003d\u003e {\n                if (event.name \u003d\u003d\u003d \u0027word\u0027) {\n                    const globalIndex \u003d startIndex + event.charIndex;\n                    charIndex \u003d globalIndex;\n                    const percent \u003d (globalIndex / textInput.value.length) * 100;\n                    progressBar.style.width \u003d percent + \u0027%\u0027;\n                }\n            };\n\n            currentUtterance \u003d utterance;\n            synth.speak(utterance);\n        }\n\n        function pauseText() {\n            synth.pause();\n        }\n\n        function resumeText() {\n            // Android Chrome often fails to resume properly via synth.resume()\n            // If it\u0027s paused, we actually restart from the last known character index\n            if (synth.paused) {\n                synth.resume();\n            } else {\n                playText(charIndex);\n            }\n        }\n\n        function stopText() {\n            synth.cancel();\n            charIndex \u003d 0;\n            progressBar.style.width \u003d \u00270%\u0027;\n            st